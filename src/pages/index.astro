---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

// Get the 3 most recent blog posts
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--primary: #3a86ff;
				--primary-dark: #2667cc;
				--secondary: #8338ec;
				--accent: #ff006e;
				--light: #f8f9fa;
				--dark: #212529;
				--text-dark: #333;
				--text-light: #f8f9fa;
				--text-muted: #6c757d;
				--background: #ffffff;
				--card-bg: #ffffff;
				--card-border: #e9ecef;
				--skill-bg: rgba(58, 134, 255, 0.05);
				--skill-hover: rgba(58, 134, 255, 0.1);
				--tag-bg: rgba(131, 56, 236, 0.1);
				--tag-color: #8338ec;
			}

			body {
				background-color: var(--background);
				color: var(--text-dark);
			}

			main {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 2rem;
			}

			.hero {
				padding: 5rem 0 3rem;
				text-align: center;
				background: linear-gradient(180deg, rgba(58, 134, 255, 0.05) 0%, rgba(255, 255, 255, 0) 100%);
				border-radius: 0 0 2rem 2rem;
			}
			.hero h1 {
				font-size: 2.8rem;
				margin-bottom: 1rem;
				background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero p {
				font-size: 1.3rem;
				max-width: 800px;
				margin: 0 auto 2rem;
				color: var(--text-muted);
				line-height: 1.6;
			}
			.section-title {
				text-align: center;
				margin-bottom: 2.5rem;
				color: var(--text-dark);
				position: relative;
				display: inline-block;
				left: 50%;
				transform: translateX(-50%);
				padding-bottom: 0.5rem;
			}
			.section-title::after {
				content: "";
				position: absolute;
				bottom: 0;
				left: 30%;
				right: 30%;
				height: 3px;
				background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
				border-radius: 3px;
			}
			.section-emoji {
				display: inline-block;
				margin-right: 0.5rem;
				font-size: 1.8rem;
				vertical-align: middle;
			}
			.skills-container {
				background-color: var(--light);
				border-radius: 1rem;
				padding: 3rem;
				margin: 4rem 0;
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
			}
			.skills-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
				gap: 1rem;
			}
			.skill-card {
				background: var(--card-bg);
				padding: 1rem;
				border-radius: 0.8rem;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
				text-align: center;
				transition: all 0.3s ease;
				border: 1px solid var(--card-border);
			}
			.skill-card:hover {
				transform: translateY(-5px);
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
				border-color: var(--primary);
				background: var(--skill-hover);
			}
			.recent-posts {
				margin: 5rem 0;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}
			.post-card {
				border-radius: 1rem;
				overflow: hidden;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
				transition: all 0.3s ease;
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				text-decoration: none;
				color: inherit;
			}
			.post-card:hover {
				transform: translateY(-10px);
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
				border-color: var(--primary);
			}
			.post-image {
				width: 100%;
				height: 220px;
				object-fit: cover;
				transition: all 0.5s ease;
			}
			.post-card:hover .post-image {
				transform: scale(1.05);
			}
			.post-content {
				padding: 1.8rem;
			}
			.post-title {
				margin: 0 0 0.8rem 0;
				font-size: 1.3rem;
				color: var(--text-dark);
				transition: color 0.3s ease;
				line-height: 1.4;
			}
			.post-card:hover .post-title {
				color: var(--primary);
			}
			.post-date {
				font-size: 0.9rem;
				color: var(--text-muted);
				margin-bottom: 0.5rem;
				display: flex;
				align-items: center;
			}
			.calendar-icon {
				margin-right: 0.4rem;
				font-size: 0.9rem;
			}
			@media (max-width: 768px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
				.hero h1 {
					font-size: 2.2rem;
				}
				.hero {
					padding: 3rem 0 2rem;
				}
				.skills-container {
					padding: 2rem 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>👋 Hello, I'm Adnan Dossaji</h1>
				<p>
					Senior Software Engineer based in Chicago with expertise in building scalable, secure applications. 
					I specialize in authentication systems, risk engineering, and full-stack development.
				</p>
			</section>

			<section class="recent-posts">
				<h2 class="section-title"><span class="section-emoji">📝</span>Recent Blog Posts</h2>
				<div class="posts-grid">
					{
						posts.map((post) => (
							<a href={`/blog/${post.id}/`} class="post-card">
								<img class="post-image" src={post.data.heroImage} alt={post.data.title} />
								<div class="post-content">
									<h3 class="post-title">{post.data.title}</h3>
									<p class="post-date"><span class="calendar-icon">📅</span><FormattedDate date={post.data.pubDate} /></p>
								</div>
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
