---
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import BlogLayout from '../../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  // Define available categories
  const categories = [
    { slug: 'tech', name: 'Technology' },
    { slug: 'programming', name: 'Programming' },
    { slug: 'personal', name: 'Personal' },
  ];
  
  return categories.map(category => ({
    params: { category: category.slug },
    props: { categoryName: category.name, categorySlug: category.slug }
  }));
}

const { categoryName, categorySlug } = Astro.props;

// Get all blog posts
const allPosts = await getCollection('blog');

// Here you would normally filter by category based on a tag in the frontmatter
// For now we'll simulate this with a simple filter
const categoryPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// For demo purposes, filter posts based on a pattern in the title or description
const filteredPosts = categoryPosts.filter(post => {
  const content = `${post.data.title} ${post.data.description}`.toLowerCase();
  
  // Simple logic to assign posts to categories for this demo
  if (categorySlug === 'tech') {
    return content.includes('api') || content.includes('oauth') || content.includes('gpt');
  } else if (categorySlug === 'programming') {
    return content.includes('react') || content.includes('website') || content.includes('integration');
  } else if (categorySlug === 'personal') {
    return content.includes('internship') || content.includes('chicago');
  }
  
  return false;
});
---

<BlogLayout 
  title={`${categoryName} Blog Posts`} 
  description={`Browse all ${categoryName} articles and insights`}
  activeCategory={categorySlug}
>
  <div class="category-header">
    <h1 class="page-title">{categoryName}</h1>
    <p class="category-description">
      Browse all posts in the {categoryName} category. 
      {filteredPosts.length ? `Showing ${filteredPosts.length} post${filteredPosts.length === 1 ? '' : 's'}.` : 'No posts found in this category.'}
    </p>
  </div>
  
  {filteredPosts.length > 0 ? (
    <ul class="blog-list">
      {filteredPosts.map((post) => (
        <li class="blog-item">
          <div class="blog-thumbnail">
            <a href={`/blog/${post.id}/`}>
              <img src={post.data.heroImage} alt={post.data.title} />
            </a>
          </div>
          <div class="blog-content">
            <h2 class="title">
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>
            <p class="date">
              <span class="date-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                </svg>
              </span>
              <FormattedDate date={post.data.pubDate} />
            </p>
            <p class="description">{post.data.description}</p>
            <div class="post-footer">
              <a href={`/blog/${post.id}/`} class="read-more">
                Read more <span class="arrow">→</span>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <div class="empty-category">
      <p>There are no posts in this category yet.</p>
      <a href="/blog" class="browse-all-btn">Browse All Posts</a>
    </div>
  )}
</BlogLayout>

<style>
  .category-header {
    margin-bottom: 2rem;
  }
  
  .page-title {
    font-size: 2.5rem;
    margin: 0 0 1rem;
    background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .category-description {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 700px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  
  .empty-category {
    background-color: var(--light);
    padding: 3rem;
    border-radius: 1rem;
    text-align: center;
    margin: 2rem 0;
  }
  
  .empty-category p {
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 1.1rem;
  }
  
  .browse-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--primary);
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  
  .browse-all-btn:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
  }
  
  .blog-list {
    list-style-type: none;
    margin: 0;
    padding: 0;
  }
  
  .blog-item {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }
  
  .blog-item:last-child {
    border-bottom: none;
  }
  
  .blog-thumbnail {
    flex: 0 0 auto;
    width: 240px;
    height: 180px;
    border-radius: 12px;
    overflow: hidden;
  }
  
  .blog-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .blog-item:hover .blog-thumbnail img {
    transform: scale(1.05);
  }
  
  .blog-content {
    flex: 1;
    min-width: 0; /* Prevent text from overflowing */
  }
  
  .title {
    margin: 0 0 0.8rem 0;
    font-size: 1.6rem;
    line-height: 1.3;
  }
  
  .title a {
    color: var(--text-dark);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  
  .blog-item:hover .title a {
    color: var(--primary);
  }
  
  .date {
    display: flex;
    align-items: center;
    margin: 0 0 0.8rem 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  
  .date-icon {
    margin-right: 0.5rem;
    display: flex;
    align-items: center;
  }
  
  .description {
    margin: 0 0 1.2rem 0;
    color: var(--text-muted);
    line-height: 1.6;
    font-size: 1rem;
  }
  
  .post-footer {
    display: flex;
    align-items: center;
  }
  
  .read-more {
    display: inline-flex;
    align-items: center;
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }
  
  .read-more:hover {
    color: var(--primary-dark);
  }
  
  .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
    margin-left: 0.25rem;
  }
  
  .read-more:hover .arrow {
    transform: translateX(3px);
  }
  
  @media (max-width: 768px) {
    .blog-item {
      flex-direction: column;
      gap: 1rem;
    }
    
    .blog-thumbnail {
      width: 100%;
      height: 200px;
    }
    
    .page-title {
      font-size: 2rem;
    }
  }
</style> 