---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="About Me" 
			description="Software engineer with a passion for photography, growing peppers, houseplants, and snowboarding" 
		/>
		<style>
			main {
				max-width: 900px;
				margin: 0 auto;
				padding: 2rem;
			}
			.page-title {
				font-size: 2.8rem;
				margin-bottom: 1.5rem;
				background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			h2 {
				border-bottom: 2px solid rgba(131, 56, 236, 0.2);
				padding-bottom: 0.5rem;
				margin-top: 2.5rem;
			}
			h2::before {
				margin-right: 0.5rem;
				font-size: 1.5rem;
			}
			h2.intro::before { content: "👋 "; }
			h2.interests::before { content: "🌱 "; }
			h2.work::before { content: "🏢 "; }
			h2.connect::before { content: "🔗 "; }
			
			p {
				line-height: 1.8;
				color: #4a4a4a;
			}
			a {
				text-decoration: none;
				border-bottom: 1px dotted #8338ec;
				transition: all 0.2s ease;
			}
			a:hover {
				color: #ff006e;
				border-bottom: 1px solid #ff006e;
			}
			.interests-icons {
				display: flex;
				justify-content: space-around;
				flex-wrap: wrap;
				margin: 1.5rem 0;
			}
			.interest-item {
				text-align: center;
				margin: 0 1rem 1.5rem;
			}
			.interest-icon {
				font-size: 2.5rem;
				margin-bottom: 0.5rem;
				display: block;
			}
			.interest-name {
				font-weight: 500;
			}
			ul {
				line-height: 1.8;
				color: #4a4a4a;
				margin-left: 1.5rem;
			}
			@media (max-width: 768px) {
				.interests-icons {
					justify-content: center;
				}
				.interest-item {
					width: 40%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">About Me</h1>

			<h2 class="intro">Hello, I'm Adnan</h2>
			<p>
				Senior Software Engineer specializing in authentication systems, API design, and building secure, scalable applications. 
				Currently at Chime. Previously at Panopta, Bank of America, AT&T, the Chicago Cubs, and Medtelligent. Former graphic designer turned engineer with a 
				passion for clean code and thoughtful experiences.
			</p>

			<h2 class="interests">Beyond the Code</h2>
			<div class="interests-icons">
				<div class="interest-item">
					<span class="interest-icon">🍴</span>
					<span class="interest-name">Gastronomy</span>
				</div>
				<div class="interest-item">
					<span class="interest-icon">📸</span>
					<span class="interest-name">Photography</span>
				</div>
				<div class="interest-item">
					<span class="interest-icon">🌿</span>
					<span class="interest-name">Gardening</span>
				</div>
				<div class="interest-item">
					<span class="interest-icon">🏂</span>
					<span class="interest-name">Snowboarding</span>
				</div>
			</div>

			<h2 class="work">Professional Journey</h2>
			<ul>
				<li><strong style="color: #3a86ff;">Chime</strong> — Risk Engineering & secure authentication systems</li>
				<li><strong style="color: #3a86ff;">Panopta</strong> — Network monitoring & performance analytics</li>
				<li><strong style="color: #3a86ff;">Bank of America Merrill Lynch</strong> — Financial market data technology</li>
				<li><strong style="color: #3a86ff;">Chicago Cubs</strong> — Ticketing systems & data analytics</li>
				<li><strong style="color: #3a86ff;">Medtelligent</strong> — Real-time interactive dashboard for employee engagement</li>
				<li><strong style="color: #3a86ff;">Design Background</strong> — Branding & visual identity for Elektro, MMM's Gourmet Ice Cream, and Koita Foods</li>
			</ul>

			<h2 class="work">Projects</h2>
			<ul>
				<li><strong style="color: #3a86ff;">Sunscape</strong> — Runescape private server</li>
				<li><strong style="color: #3a86ff;">180 designs</strong> — Graphic design forum run on a freemium forum software</li>
				<li><strong style="color: #3a86ff;">DelusionFX</strong> — Yet another graphic design forum run on Invision Board</li>
				<li><strong style="color: #3a86ff;">Northtrack: NAXP</strong> — Nurse education experience tracker</li>
				<li><strong style="color: #3a86ff;">Nano Labs</strong> — Consulting & development</li>
				<li><strong style="color: #3a86ff;">Timedish</strong> — Event-based social network</li>
				<li><strong style="color: #3a86ff;">Webseam</strong> — Web3 website builder</li>
			</ul>

			<h2 class="connect">Let's Connect</h2>
			<p>
				Find me on 
				<a href="https://github.com/adnandossaji" target="_blank">GitHub</a>, 
				<a href="https://instagram.com/adnanprint" target="_blank">Instagram</a>, or 
				<a href="https://linkedin.com/in/adnandossaji" target="_blank">LinkedIn</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
