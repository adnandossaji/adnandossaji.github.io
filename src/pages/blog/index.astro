---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BlogLayout title="Archive" description="Read the latest articles and insights from Adnan Dossaji">
	<main class="content-container" style="padding-top: var(--space-16);">
		<div class="side-column">
			<span class="mono-meta label-bold">ARCHIVE</span>
			<div class="index-number" style="margin-top: 1rem;">({posts.length})</div>
		</div>
		<section class="main-column">
			<div class="posts-list">
				{
					posts.map((post, index) => (
						<a href={`/blog/${post.id}/`} class="post-item">
							<div class="post-item-left">
								<div class="index-number">{index + 1 < 10 ? `0${index + 1}` : index + 1}</div>
								<div class="post-date mono-meta">
									<FormattedDate date={post.data.pubDate} />
								</div>
							</div>
							<span class="post-title">{post.data.title}</span>
						</a>
					))
				}
			</div>
		</section>
	</main>
</BlogLayout>

<style>
	.posts-list {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 4vw, 2rem);
	}
	.post-item {
		display: flex;
		align-items: flex-start;
		gap: var(--space-8);
		padding: 0.5rem 0;
		transition: opacity 0.2s ease;
		text-decoration: none;
		color: inherit;
	}
	.post-item:hover {
		opacity: 0.6;
	}
	.post-item-left {
		display: flex;
		gap: 1.5rem;
		align-items: baseline;
		width: var(--grid-sidebar-width);
		flex-shrink: 0;
	}
	.post-title {
		font-size: clamp(1.1rem, 4vw, 1.5rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	
	@media (max-width: 768px) {
		.post-item {
			flex-direction: column;
			gap: 0.25rem;
			padding: 1rem 0; /* Increased tap target */
		}
		.post-item-left {
			width: auto;
			gap: 1rem;
		}
	}
</style>
