---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { client } from '../../tina/__generated__/client';
import TinaAbout from '../components/TinaAbout';

const aboutData = await client.queries.about({ relativePath: 'index.md' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="About Me" 
			description="Software engineer with a passion for photography, growing peppers, houseplants, and snowboarding" 
		/>
	</head>
	<body>
		<Header />
		
		<main class="content-container">
			<div class="side-column">
				<span class="mono-meta label-bold">INFO</span>
			</div>
			<article class="main-column">
				<TinaAbout {...aboutData} client:load />
			</article>
		</main>

		<Footer />
	</body>
</html>
