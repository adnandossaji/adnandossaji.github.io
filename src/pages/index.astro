---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { client } from '../../tina/__generated__/client';
import TinaHome from '../components/TinaHome';

// Get the 3 most recent blog posts
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const homeData = await client.queries.home({ relativePath: 'index.md' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="content-container">
			<div class="side-column">
				<span class="mono-meta label-bold">INTRO</span>
			</div>
			<div class="main-column hero-section">
				<TinaHome {...homeData} client:load />
			</div>

			<div class="side-column">
				<span class="mono-meta label-bold">ARCHIVE</span>
				<div class="index-number" style="margin-top: 1rem;">(6)</div>
			</div>
			<div class="main-column posts-section">
				<div class="posts-list">
					{
						posts.map((post, index) => (
							<a href={`/blog/${post.id}/`} class="post-item">
								<div class="post-item-left">
									<div class="index-number">{index + 1 < 10 ? `0${index + 1}` : index + 1}</div>
									<div class="post-date mono-meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</div>
								<span class="post-title">{post.data.title}</span>
							</a>
						))
					}
				</div>
			</div>
		</main>

		<Footer />

		<style>
			.hero-section {
				margin-bottom: var(--space-16);
			}
			.posts-list {
				display: flex;
				flex-direction: column;
				gap: clamp(1rem, 3vw, 1.5rem);
			}
			.post-item {
				display: flex;
				align-items: flex-start;
				gap: var(--space-8);
				padding: 0.5rem 0;
				transition: opacity 0.2s ease;
			}
			.post-item:hover {
				opacity: 0.7;
			}
			.post-item-left {
				display: flex;
				gap: 1rem;
				align-items: baseline;
				width: var(--grid-sidebar-width);
				flex-shrink: 0;
			}
			.post-title {
				font-size: clamp(1rem, 4vw, 1.25rem);
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.01em;
			}
			
			@media (max-width: 768px) {
				.post-item {
					flex-direction: column;
					gap: 0.25rem;
					padding: 1rem 0; /* Increased tap target */
				}
				.post-item-left {
					width: auto;
					gap: 0.75rem;
				}
				.hero-section {
					margin-bottom: var(--space-12);
				}
			}
		</style>
	</body>
</html>
