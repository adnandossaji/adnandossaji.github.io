---
// SearchBar.astro - A client-side search component with real-time filtering
---

<div class="search-container">
  <form id="searchForm" class="search-form" action="/blog/search">
    <input 
      type="text" 
      id="searchInput" 
      name="q"
      placeholder="Search blog posts..." 
      class="search-input"
      aria-label="Search blog posts"
    />
    <button type="submit" class="search-button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
      </svg>
    </button>
  </form>
</div>

<script>
  // Client-side search functionality
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('searchForm');
    const input = document.getElementById('searchInput') as HTMLInputElement;
    
    if (form && input) {
      // Handle form submission (for full search page)
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Get the search term and trim whitespace
        const searchTerm = input.value.trim();
        
        if (searchTerm) {
          // Redirect to search results page with the search term as a query parameter
          window.location.href = `/blog/search?q=${encodeURIComponent(searchTerm)}`;
        } else {
          // If empty search, just show all posts on the current page
          window.location.href = `/blog`;
        }
      });
      
      // Real-time filtering
      input.addEventListener('input', () => {
        const searchTerm = input.value.trim().toLowerCase();
        
        // Find all blog post cards in the current page
        const postCards = document.querySelectorAll('.blog-post-card');
        
        if (postCards.length > 0) {
          // Get the "no results" element (create it if it doesn't exist)
          let noResultsEl = document.querySelector('.no-results-message');
          if (!noResultsEl) {
            noResultsEl = document.createElement('div');
            noResultsEl.className = 'no-results-message';
            noResultsEl.innerHTML = '<p>No matching posts found. Try a different search term.</p>';
            
            // Insert after the blog grid
            const blogGrid = document.querySelector('.blog-grid');
            if (blogGrid) {
              blogGrid.after(noResultsEl);
            } else {
              form.after(noResultsEl);
            }
            
            // Initially hide it
            (noResultsEl as HTMLElement).style.display = 'none';
          }
          
          let visibleCount = 0;
          
          // Filter the posts based on the search term
          postCards.forEach(card => {
            const title = card.querySelector('.blog-title')?.textContent?.toLowerCase() || '';
            const description = card.querySelector('.blog-description')?.textContent?.toLowerCase() || '';
            const content = title + ' ' + description;
            
            // If search term is empty, show all posts
            if (searchTerm === '') {
              (card as HTMLElement).style.display = '';
              visibleCount++;
              
              // Reset highlighted content when search is cleared
              const highlightedElements = card.querySelectorAll('.blog-title, .blog-description');
              highlightedElements.forEach(el => {
                el.innerHTML = el.textContent || '';
              });
            } 
            // Otherwise filter based on search term
            else if (content.includes(searchTerm)) {
              (card as HTMLElement).style.display = '';
              visibleCount++;
              
              try {
                // Highlight titles
                const titleEl = card.querySelector('.blog-title');
                if (titleEl && titleEl.textContent) {
                  const originalText = titleEl.textContent;
                  const escapedQuery = searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                  const regex = new RegExp(`(${escapedQuery})`, 'gi');
                  if (originalText.toLowerCase().includes(searchTerm)) {
                    titleEl.innerHTML = originalText.replace(
                      regex, 
                      '<span class="search-highlight">$1</span>'
                    );
                  }
                }
                
                // Highlight descriptions
                const descEl = card.querySelector('.blog-description');
                if (descEl && descEl.textContent) {
                  const originalText = descEl.textContent;
                  const escapedQuery = searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                  const regex = new RegExp(`(${escapedQuery})`, 'gi');
                  if (originalText.toLowerCase().includes(searchTerm)) {
                    descEl.innerHTML = originalText.replace(
                      regex, 
                      '<span class="search-highlight">$1</span>'
                    );
                  }
                }
              } catch (error) {
                console.error('Error highlighting search terms:', error);
              }
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
          
          // Show/hide the "no results" message
          (noResultsEl as HTMLElement).style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
      
      // Set initial value from URL if present (but reset if empty)
      const urlParams = new URLSearchParams(window.location.search);
      const queryParam = urlParams.get('q');
      if (queryParam) {
        input.value = queryParam;
        // Trigger the input event to filter immediately
        input.dispatchEvent(new Event('input'));
      }
    }
  });
</script>

<style>
  .search-container {
    margin-bottom: 1rem;
  }
  
  .search-form {
    display: flex;
    position: relative;
  }
  
  .search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0.5rem;
    font-size: 0.95rem;
    background-color: white;
    color: var(--text-dark);
    transition: all 0.2s ease;
  }
  
  .search-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(58, 134, 255, 0.2);
  }
  
  .search-button {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    padding: 0 1rem;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }
  
  .search-button:hover {
    color: var(--primary);
  }
  
  .no-results-message {
    margin: 2rem 0;
    padding: 1.5rem;
    background-color: var(--light);
    border-radius: 0.5rem;
    text-align: center;
    color: var(--text-muted);
  }
  
  :global(.search-highlight) {
    background-color: rgba(58, 134, 255, 0.15);
    padding: 0.1rem 0.2rem;
    border-radius: 0.2rem;
    font-weight: 500;
    color: var(--primary);
  }
</style> 