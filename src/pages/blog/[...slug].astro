---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { client } from '../../../tina/__generated__/client';
import TinaBlogPost from '../../components/blog/TinaBlogPost';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Fetch TinaCMS data for visual editing
const tinaData = await client.queries.blog({ relativePath: `${post.id}.md` });
---

<BlogLayout title={post.data.title} description={post.data.description}>
	<style is:global>
		@import "../../styles/blog-post.css";
	</style>
	<TinaBlogPost {...tinaData} client:load />
	
	<footer class="post-footer">
		<div class="footer-nav">
			<a href="/blog" class="mono-meta">&larr; Back to Archive</a>
		</div>
		
		<div class="share-links mono-meta">
			<span>Share:</span>
			<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://adnan.dossaji.com/blog/${post.id}/`)}`} target="_blank" rel="noopener noreferrer">Twitter</a>
			<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://adnan.dossaji.com/blog/${post.id}/`)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
	</footer>
</BlogLayout>
