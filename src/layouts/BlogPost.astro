---
import type { CollectionEntry } from 'astro:content';
import BlogLayout from './BlogLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BlogLayout title={title} description={description}>
	<main class="content-container">
		<div class="side-column">
			<div class="post-meta-sticky">
				<span class="mono-meta label-bold">DATE</span>
				<div class="mono-meta" style="margin-top: 0.5rem;">
					<FormattedDate date={pubDate} />
				</div>
				{
					updatedDate && (
						<div class="mono-meta" style="margin-top: 1.5rem;">
							<span class="label-bold">UPDATED</span>
							<div style="margin-top: 0.5rem;"><FormattedDate date={updatedDate} /></div>
						</div>
					)
				}
			</div>
		</div>

		<article class="main-column">
			<div class="post-header">
				<h1 class="post-title">{title}</h1>
				{heroImage && <img src={heroImage} alt="" class="hero-image" />}
			</div>
			<div class="prose">
				<slot />
			</div>
			<footer class="post-footer">
				<a href="/blog" class="back-link mono-meta label-bold">&larr; Back to Archive</a>
			</footer>
		</article>
	</main>
</BlogLayout>

<style>
	.content-container {
		padding-top: var(--space-16);
	}
	.post-meta-sticky {
		position: sticky;
		top: calc(var(--space-8) + 2rem);
	}
	.post-header {
		margin-bottom: var(--space-12);
	}
	.post-title {
		font-size: clamp(2rem, 8vw, 3.5rem);
		font-weight: 800;
		line-height: 1.05;
		margin-bottom: var(--space-8);
		letter-spacing: -0.03em;
	}
	.hero-image {
		width: 100%;
		height: auto;
		display: block;
		margin-bottom: var(--space-8);
	}
	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}
	.post-footer {
		margin-top: var(--space-16);
		border-top: var(--border-hairline);
		padding-top: var(--space-8);
	}
	.back-link {
		display: inline-block;
		padding: 0.5rem 0;
	}
	
	@media (max-width: 768px) {
		.post-meta-sticky {
			position: static;
			margin-bottom: var(--space-8);
		}
		.back-link {
			padding: 1rem 0; /* Larger tap target on mobile */
		}
	}
</style>
