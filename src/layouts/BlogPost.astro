---
import type { CollectionEntry } from 'astro:content';
import BlogLayout from './BlogLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BlogLayout title={title} description={description}>
	<article class="blog-post">
		<div class="post-header">
			<div class="post-meta">
				<div class="post-date">
					<span class="date-icon">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
							<path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
						</svg>
					</span>
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="updated-date">
								· Updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</div>
			</div>
			<h1 class="post-title">{title}</h1>
		</div>
		
		<div class="hero-image">
			{heroImage && <img src={heroImage} alt={title} />}
		</div>
		
		<div class="post-content">
			<slot />
		</div>
		
		<div class="post-footer">
			<div class="post-navigation">
				<a href="/blog" class="back-to-blog">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
						<path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
					</svg>
					Back to all posts
				</a>
			</div>
			
			<div class="share-post">
				<span class="share-label">Share this post:</span>
				<div class="share-buttons">
					<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://yourdomain.com/blog/${title.toLowerCase().replace(/\s+/g, '-')}/`)}`} target="_blank" rel="noopener noreferrer" class="share-button twitter">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
							<path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"/>
						</svg>
					</a>
					<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://yourdomain.com/blog/${title.toLowerCase().replace(/\s+/g, '-')}/`)}`} target="_blank" rel="noopener noreferrer" class="share-button linkedin">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
							<path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</article>
</BlogLayout>

<style>
	.blog-post {
		max-width: 900px;
		margin: 0 auto;
	}
	
	.post-header {
		margin-bottom: 2rem;
	}
	
	.post-meta {
		margin-bottom: 1rem;
	}
	
	.post-date {
		display: flex;
		align-items: center;
		font-size: 0.95rem;
		color: var(--text-muted);
	}
	
	.date-icon {
		display: flex;
		align-items: center;
		margin-right: 0.5rem;
	}
	
	.updated-date {
		font-style: italic;
	}
	
	.post-title {
		font-size: 2.8rem;
		margin: 0;
		line-height: 1.2;
		background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	
	.hero-image {
		margin: 2rem 0;
		border-radius: 1rem;
		overflow: hidden;
		max-height: 500px;
	}
	
	.hero-image img {
		width: 100%;
		object-fit: cover;
	}
	
	.post-content {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-dark);
	}
	
	.post-content :global(h2) {
		font-size: 1.8rem;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: var(--text-dark);
	}
	
	.post-content :global(h3) {
		font-size: 1.4rem;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		color: var(--text-dark);
	}
	
	.post-content :global(p) {
		margin-bottom: 1.5rem;
	}
	
	.post-content :global(img) {
		max-width: 100%;
		border-radius: 0.5rem;
		margin: 1.5rem 0;
	}
	
	.post-content :global(a) {
		color: var(--primary);
		text-decoration: none;
		border-bottom: 1px solid transparent;
		transition: all 0.2s ease;
	}
	
	.post-content :global(a:hover) {
		border-bottom-color: var(--primary);
	}
	
	.post-content :global(ul), .post-content :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}
	
	.post-content :global(li) {
		margin-bottom: 0.5rem;
	}
	
	.post-content :global(blockquote) {
		border-left: 4px solid var(--primary);
		padding-left: 1.5rem;
		margin-left: 0;
		color: var(--text-muted);
		font-style: italic;
	}
	
	.post-content :global(pre) {
		background-color: var(--dark);
		color: var(--light);
		padding: 1.5rem;
		border-radius: 0.5rem;
		overflow-x: auto;
		font-size: 0.9rem;
		margin: 1.5rem 0;
	}
	
	.post-content :global(code) {
		background-color: rgba(0, 0, 0, 0.05);
		padding: 0.2rem 0.4rem;
		border-radius: 0.3rem;
		font-size: 0.9em;
	}
	
	.post-footer {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(0, 0, 0, 0.05);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	
	.back-to-blog {
		display: inline-flex;
		align-items: center;
		color: var(--primary);
		text-decoration: none;
		font-weight: 500;
		gap: 0.5rem;
		transition: all 0.2s ease;
	}
	
	.back-to-blog:hover {
		color: var(--primary-dark);
	}
	
	.share-post {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	
	.share-label {
		font-size: 0.9rem;
		color: var(--text-muted);
	}
	
	.share-buttons {
		display: flex;
		gap: 0.5rem;
	}
	
	.share-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 50%;
		background-color: rgba(0, 0, 0, 0.05);
		color: var(--text-dark);
		transition: all 0.2s ease;
	}
	
	.share-button:hover {
		background-color: var(--primary);
		color: white;
	}
	
	@media (max-width: 768px) {
		.post-title {
			font-size: 2rem;
		}
		
		.post-footer {
			flex-direction: column;
			align-items: flex-start;
		}
		
		.share-post {
			margin-top: 1rem;
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
